  },
  "target_users": {
    "primary": [
      "Tourists (domestic and international)",
      "Police officers (L1-L4)",
      "Tourism department officials"
    ],
    "secondary": [
      "Emergency services",
      "Local administration",
      "Tourism operators (future scope)"
    ]
  },
  "objectives": [
    "Ensure tourist safety without intrusive surveillance",
    "Enable real-time incident detection and response",
    "Provide secure, time-bound digital tourist identities",
    "Support data-driven decision-making for authorities",
    "Maintain strict privacy and compliance standards",
    "Improve trust in tourism infrastructure"
  ],
