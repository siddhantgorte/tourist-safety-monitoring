generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Region {
  id        String     @id @default(uuid())
  name      String
  type      RegionType
  parentId  String?
  createdAt DateTime   @default(now())
  geometry  Json?
  incidents Incident[]
  parent    Region?    @relation("RegionHierarchy", fields: [parentId], references: [id])
  children  Region[]   @relation("RegionHierarchy")
  users     User[]
  zones     Zone[]
}

model User {
  id                String               @id @default(uuid())
  username          String               @unique
  password          String
  fullName          String?
  roleId            String
  regionId          String?
  isOnDuty          Boolean              @default(false)
  isOnline          Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  auditLogs         AuditLog[]
  actions           IncidentAction[]
  assignedIncidents IncidentAssignment[]
  region            Region?              @relation(fields: [regionId], references: [id])
  role              Role                 @relation(fields: [roleId], references: [id])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  permissions Permission[]
  users       User[]
}

model Permission {
  id     String @id @default(uuid())
  name   String @unique
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
}

model Tourist {
  id            String         @id @default(uuid())
  phoneNumber   String         @unique
  fullName      String?
  nationality   String?
  createdAt     DateTime       @default(now())
  devices       Device[]
  incidents     Incident[]
  notifications Notification[]
  trips         Trip[]
}

model Trip {
  id              String            @id @default(uuid())
  touristId       String
  startDate       DateTime          @default(now())
  endDate         DateTime?
  isActive        Boolean           @default(true)
  currentLat      Float?
  currentLng      Float?
  lastUpdate      DateTime?         @default(now())
  aiAlerts        AIAlert[]
  deviceTelemetry DeviceTelemetry[]
  digitalId       DigitalID?
  geoEvents       GeoEvent[]
  incidents       Incident[]
  locations       LocationUpdate[]
  safetyScores    SafetyScore[]
  tourist         Tourist           @relation(fields: [touristId], references: [id])
}

model DigitalID {
  id             String         @id @default(uuid())
  tripId         String         @unique
  qrCodeData     String
  generatedAt    DateTime       @default(now())
  expiresAt      DateTime
  blockchainHash String?
  trip           Trip           @relation(fields: [tripId], references: [id])
  verifications  Verification[]
}

model Verification {
  id           String    @id @default(uuid())
  digitalId    String
  verifierId   String?
  verifiedAt   DateTime  @default(now())
  location     String?
  isSuccessful Boolean
  digital      DigitalID @relation(fields: [digitalId], references: [id])
}

model Zone {
  id          String     @id @default(uuid())
  name        String
  riskLevel   String     @default("LOW")
  description String?
  regionId    String?
  createdAt   DateTime   @default(now())
  fences      GeoFence[]
  incidents   Incident[]
  region      Region?    @relation(fields: [regionId], references: [id])
}

model GeoFence {
  id          String     @id @default(uuid())
  zoneId      String
  name        String
  coordinates Json
  type        String
  events      GeoEvent[]
  zone        Zone       @relation(fields: [zoneId], references: [id])
}

model GeoEvent {
  id         String   @id @default(uuid())
  tripId     String
  geoFenceId String
  eventType  String
  timestamp  DateTime @default(now())
  geoFence   GeoFence @relation(fields: [geoFenceId], references: [id])
  trip       Trip     @relation(fields: [tripId], references: [id])
}

model Incident {
  id            String               @id @default(uuid())
  type          String
  severity      String
  status        String               @default("OPEN")
  description   String?
  regionId      String?
  zoneId        String?
  tripId        String?
  touristId     String?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  aiAlertId     String?              @unique
  evidence      Evidence[]
  aiAlertLink   AIAlert?             @relation(fields: [aiAlertId], references: [id])
  region        Region?              @relation(fields: [regionId], references: [id])
  tourist       Tourist?             @relation(fields: [touristId], references: [id])
  trip          Trip?                @relation(fields: [tripId], references: [id])
  zone          Zone?                @relation(fields: [zoneId], references: [id])
  actions       IncidentAction[]
  assignments   IncidentAssignment[]
  notifications Notification[]
  messages      IncidentMessage[]
}

model IncidentMessage {
  id         String   @id @default(uuid())
  incidentId String
  senderRole String   // 'tourist' | 'admin' | 'system'
  senderId   String?  // Optional, can be tourist ID or admin user ID
  content    String
  timestamp  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id])
}

model IncidentAssignment {
  id         String   @id @default(uuid())
  incidentId String
  userId     String
  assignedAt DateTime @default(now())
  status     String   @default("ACTIVE")
  incident   Incident @relation(fields: [incidentId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model IncidentAction {
  id         String   @id @default(uuid())
  incidentId String
  userId     String?
  actionType String
  details    String?
  timestamp  DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])
}

model Evidence {
  id         String   @id @default(uuid())
  incidentId String
  fileUrl    String
  fileType   String
  uploadedAt DateTime @default(now())
  hash       String?
  incident   Incident @relation(fields: [incidentId], references: [id])
}

model LocationUpdate {
  id        String   @id @default(uuid())
  tripId    String
  latitude  Float
  longitude Float
  accuracy  Float?
  timestamp DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id])

  @@index([tripId, timestamp])
}

model Device {
  id        String            @id @default(uuid())
  touristId String
  type      String
  tourist   Tourist           @relation(fields: [touristId], references: [id])
  telemetry DeviceTelemetry[]
}

model DeviceTelemetry {
  id        String   @id @default(uuid())
  deviceId  String
  tripId    String?
  battery   Int?
  signal    Int?
  timestamp DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id])
  trip      Trip?    @relation(fields: [tripId], references: [id])
}

model AIAlert {
  id         String    @id @default(uuid())
  tripId     String
  type       String
  confidence Float
  createdAt  DateTime  @default(now())
  trip       Trip      @relation(fields: [tripId], references: [id])
  incident   Incident?
}

model SafetyScore {
  id        String   @id @default(uuid())
  tripId    String
  score     Float
  factors   Json?
  timestamp DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id])
}

model Notification {
  id         String    @id @default(uuid())
  message    String
  type       String
  userId     String?
  touristId  String?
  incidentId String?
  sentAt     DateTime  @default(now())
  isRead     Boolean   @default(false)
  incident   Incident? @relation(fields: [incidentId], references: [id])
  tourist    Tourist?  @relation(fields: [touristId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  resource  String
  details   Json?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum RegionType {
  COUNTRY
  STATE
  DIVISION
  DISTRICT
}
