generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Users & Auth
model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String // Hashed
  fullName  String?
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  isOnDuty  Boolean  @default(false)
  isOnline  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedZones     UserZone[]
  assignedIncidents IncidentAssignment[]
  actions           IncidentAction[]
  auditLogs         AuditLog[]
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // L1, L2, L3, L4, ADMIN
  permissions Permission[]
  users       User[]
}

model Permission {
  id     String @id @default(uuid())
  name   String @unique // e.g. "view_incidents"
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
}

// 2. Tourists & Identity
model Tourist {
  id          String   @id @default(uuid())
  phoneNumber String   @unique // Identity anchor
  fullName    String?
  nationality String?
  createdAt   DateTime @default(now())

  trips         Trip[]
  incidents     Incident[]
  devices       Device[]
  notifications Notification[]
}

model Trip {
  id        String    @id @default(uuid())
  touristId String
  tourist   Tourist   @relation(fields: [touristId], references: [id])
  startDate DateTime  @default(now())
  endDate   DateTime?
  isActive  Boolean   @default(true)

  digitalId       DigitalID?
  locations       LocationUpdate[]
  geoEvents       GeoEvent[]
  incidents       Incident[]
  aiAlerts        AIAlert[]
  safetyScores    SafetyScore[]
  deviceTelemetry DeviceTelemetry[]
}

model DigitalID {
  id             String    @id @default(uuid())
  tripId         String    @unique
  trip           Trip      @relation(fields: [tripId], references: [id])
  qrCodeData     String // Encrypted or signed payload
  generatedAt    DateTime  @default(now())
  expiresAt      DateTime
  blockchainHash String? // Anchor to blockchain
  verifications  Verification[]
}

model Verification {
  id          String    @id @default(uuid())
  digitalId   String
  digital     DigitalID @relation(fields: [digitalId], references: [id])
  verifierId  String? // Officer ID or Scanner ID
  verifiedAt  DateTime  @default(now())
  location    String? // GPS or description
  isSuccessful Boolean
}

// 3. Location & Zones
model Zone {
  id          String   @id @default(uuid())
  name        String
  riskLevel   String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  description String?
  createdAt   DateTime @default(now())

  geoFences UserZone[]
  fences    GeoFence[]
  incidents Incident[]
}

model UserZone {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  zoneId String
  zone   Zone   @relation(fields: [zoneId], references: [id])

  @@id([userId, zoneId])
}

model GeoFence {
  id          String     @id @default(uuid())
  zoneId      String
  zone        Zone       @relation(fields: [zoneId], references: [id])
  name        String
  coordinates Json // Polygon points
  type        String // SAFE, DANGER, RESTRICTED
  events      GeoEvent[]
}

model GeoEvent {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id])
  geoFenceId String
  geoFence   GeoFence @relation(fields: [geoFenceId], references: [id])
  eventType  String // ENTRY, EXIT
  timestamp  DateTime @default(now())
}

// 4. Incidents
model Incident {
  id          String   @id @default(uuid())
  type        String // PANIC, LOST, THEFT, HARASSMENT, AI_ANOMALY
  severity    String // INFO, WARNING, CRITICAL
  status      String   @default("OPEN") // OPEN, ASSIGNED, RESPONDING, RESOLVED, FALSE_ALARM
  description String?
  zoneId      String?
  zone        Zone?    @relation(fields: [zoneId], references: [id])
  tripId      String? // Optional (if linked to a tourist)
  trip        Trip?    @relation(fields: [tripId], references: [id])
  touristId   String? // Direct link backup
  tourist     Tourist? @relation(fields: [touristId], references: [id])

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments   IncidentAssignment[]
  actions       IncidentAction[]
  evidence      Evidence[]
  aiAlertLink   AIAlert?             @relation(fields: [aiAlertId], references: [id])
  aiAlertId     String?              @unique
  notifications Notification[]
}

model IncidentAssignment {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())
  status     String   @default("ACTIVE") // ACTIVE, COMPLETED
}

model IncidentAction {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  userId     String? // Nullable if system action
  user       User?    @relation(fields: [userId], references: [id])
  actionType String // STATUS_CHANGE, NOTE, OFFICER_ASSIGN, ESCALATE
  details    String?
  timestamp  DateTime @default(now())
}

model Evidence {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  fileUrl    String
  fileType   String // IMAGE, AUDIO, VIDEO
  uploadedAt DateTime @default(now())
  hash       String? // Blockchain anchor
}

// 5. Tracking & IO
model LocationUpdate {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  latitude  Float
  longitude Float
  accuracy  Float?
  timestamp DateTime @default(now())

  @@index([tripId, timestamp])
}

model Device {
  id        String            @id @default(uuid())
  touristId String
  tourist   Tourist           @relation(fields: [touristId], references: [id])
  type      String // BAND, APP_INSTANCE
  telemetry DeviceTelemetry[]
}

model DeviceTelemetry {
  id        String   @id @default(uuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  tripId    String? // Link to specific trip
  trip      Trip?    @relation(fields: [tripId], references: [id])
  battery   Int?
  signal    Int?
  timestamp DateTime @default(now())
}

// 6. AI & Monitoring
model AIAlert {
  id         String    @id @default(uuid())
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id])
  type       String // INACTIVITY, DEVIATION, SIGNAL_LOSS
  confidence Float
  createdAt  DateTime  @default(now())
  incident   Incident?
}

model SafetyScore {
  id        String   @id @default(uuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id])
  score     Float // 0-100
  factors   Json? // Why the score changed
  timestamp DateTime @default(now())
}

// 7. System
model Notification {
  id        String    @id @default(uuid())
  message   String
  type      String // PUSH, SMS
  userId    String? // For officers
  touristId String? // For tourists
  tourist   Tourist?  @relation(fields: [touristId], references: [id])
  incidentId String?
  incident  Incident? @relation(fields: [incidentId], references: [id])
  sentAt    DateTime  @default(now())
  isRead    Boolean   @default(false)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  resource  String
  details   Json?
  timestamp DateTime @default(now())
}
